<schemalist>
  <schema id="org.gnome.shell.extensions.logseq-hud-do" path="/org/gnome/shell/extensions/logseq-hud-do/">
    <key name="task-text-filters" type="as"><default>['^[ \t]*relay-id::']</default><summary>Regex patterns for hiding description lines</summary></key>
    <key name="task-block-filters" type="a(ss)"><default>[(':LOGBOOK:', ':END:')]</default><summary>Literal start and end markers for hiding description blocks</summary></key>
    <key name="hidden-tasks-v2" type="s"><default>'{"version":2,"tasks":[]}'</default><summary>Version 2 hidden logical tasks</summary></key>
    <key name="graphs" type="a(ss)"><default>[]</default><summary>Graph directories and display names</summary></key>
    <key name="refresh-interval" type="i"><default>30</default><range min="5" max="86400"/><summary>Refresh interval in seconds</summary></key>
    <key name="horizon" type="i"><default>7</default><range min="0" max="3650"/><summary>Upcoming horizon in days</summary></key>
    <key name="show-today-unscheduled" type="b"><default>true</default><summary>Show today's unscheduled tasks</summary></key>
    <key name="today-priority-a-first" type="b"><default>true</default><summary>Prioritize today's high priority tasks (#A)</summary><description>Show Priority A tasks first in Today, regardless of TODO or DOING status.</description></key>
    <key name="show-overdue" type="b"><default>true</default><summary>Show Overdue</summary></key>
    <key name="show-upcoming" type="b"><default>true</default><summary>Show Upcoming</summary></key>
    <key name="show-today-count" type="b"><default>true</default><summary>Show Today count</summary></key>
  </schema>
</schemalist>
